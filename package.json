{
  "name": "openrouter-free-proxy",
  "version": "1.0.0",
  "description": "Zero-dependency proxy that routes OpenAI-compatible and Anthropic Messages requests to free-tier models with automatic failover.",
  "private": true,
  "type": "module",
  "main": "router.mjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "init": "node scripts/proxy.mjs init",
    "start": "node router.mjs",
    "proxy:run": "node scripts/proxy.mjs run",
    "proxy:start": "node scripts/proxy.mjs start",
    "proxy:stop": "node scripts/proxy.mjs stop",
    "proxy:restart": "node scripts/proxy.mjs restart",
    "proxy:status": "node scripts/proxy.mjs status",
    "autostart:install": "node scripts/proxy.mjs install-autostart",
    "autostart:uninstall": "node scripts/proxy.mjs uninstall-autostart"
  }
}
