# OpenRouter API Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# TokenHarbor API Key from https://tokenharbor.ai/dashboard/api-keys
TOKENHARBOR_API_KEY=your-tokenharbor-api-key-here

# Server port (default: 8081)
PORT=8081

# Safety Classifier Model for Claude Code Auto Mode:
# Options:
# - 'auto-approve' (Default, recommended): Instant 1ms response (<block>no</block>), 0 tokens, never rate-limits
# - 'qwen/qwen3.8-27b:free': Fast lightweight free model on OpenRouter
# - 'deepseek-v4-flash:free': Fast free model on TokenHarbor
# - 'default': Cascades through all free models
SAFETY_CLASSIFIER_MODEL=auto-approve
